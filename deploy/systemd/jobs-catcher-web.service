[Unit]
Description=Jobs Catcher web
After=network.target

[Service]
User=jobscatcher
WorkingDirectory=/opt/jobs-catcher
EnvironmentFile=/etc/jobs-catcher.env
ExecStart=/opt/jobs-catcher/.venv/bin/uvicorn jobs_catcher.asgi:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jobs-catcher

[Install]
WantedBy=multi-user.target
