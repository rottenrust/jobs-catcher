[Unit]
Description=Jobs Catcher worker
After=network.target jobs-catcher-web.service

[Service]
User=jobscatcher
WorkingDirectory=/opt/jobs-catcher
EnvironmentFile=/etc/jobs-catcher.env
ExecStart=/opt/jobs-catcher/.venv/bin/python -m jobs_catcher.worker
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jobs-catcher

[Install]
WantedBy=multi-user.target
